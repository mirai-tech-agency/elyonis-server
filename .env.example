# Copy to .env and fill in.

# HTTP port (Cloudflare Tunnel will point at this).
PORT=3000

# HMAC secret used to sign activation tokens. The client verifies offline
# against this via a constant baked into the Elyonis build. CHANGE THIS
# BEFORE FIRST DEPLOY (32+ random bytes hex-encoded).
HMAC_SECRET=change-me-to-a-long-random-hex-string

# Bearer token for /api/admin/* endpoints. Long random string, kept off-repo.
ADMIN_TOKEN=change-me-to-another-long-random-string

# Postgres connection string (Neon project "elyonis-license"). For local
# dev use a Neon branch, not the production branch.
DATABASE_URL=postgresql://user:password@host/elyonis?sslmode=require

# --- Voix naturelles (ElevenLabs) ---------------------------------
# Clé du fournisseur. Elle ne quitte JAMAIS ce serveur : Elyonis appelle
# /api/tts avec sa licence, le serveur appelle ElevenLabs. Laisser vide
# désactive proprement l'option (Elyonis reste sur les voix Windows).
ELEVENLABS_API_KEY=

# Catalogue des voix françaises proposées, dans l'ordre affiché par Elyonis.
# Les identifiants viennent de la bibliothèque ElevenLabs (onglet Voices).
TTS_VOICES=[{"id":"","name":"Léa"},{"id":"","name":"Marc"},{"id":"","name":"Chloé"}]

# Facultatif : modèle et format audio.
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_FORMAT=mp3_22050_32
